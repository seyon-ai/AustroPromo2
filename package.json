{
  "name": "austroclash-promo",
  "version": "1.0.0",
  "private": true,
  "description": "AustroClash launch promo built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "build:timing": "node scripts/build-timing.mjs",
    "build:assets": "python3 scripts/make_sfx_music.py && python3 scripts/make_logo.py",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render AustroClashPromo out/AustroClashPromo.mp4 --codec=h264 --crf=18 --concurrency=2",
    "render:vertical": "remotion render AustroClashPromoVertical out/AustroClashPromoVertical.mp4 --codec=h264 --crf=18 --concurrency=2"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "remotion": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/node": "20.17.6",
    "typescript": "5.6.3",
    "ffprobe-static": "3.1.0"
  }
}
